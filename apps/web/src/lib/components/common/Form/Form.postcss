.form {
  --form-gap: var(--indent);

  display: flex;
  flex-direction: column;
  gap: var(--form-gap);

  &__header {
    display: flex;
    justify-content: center;
  }

  &__body {
    display: flex;
    flex-direction: column;
    gap: var(--form-gap);
  }

  &__message {
    min-height: 1lh;
    text-align: center;
  }

  &__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--form-gap);
  }

  &__extra {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--indent-half);
  }
}